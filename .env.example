# Japan -> DMV Arbitrage Analytics -- environment template.
# Copy to .env and fill in whatever you have. EVERY key is optional:
# collectors that lack credentials are skipped and logged, and the pipeline
# still runs end-to-end on manual imports / sample data.

# --- eBay (Browse API, production) ---
# https://developer.ebay.com/api-docs/buy/static/api-browse.html
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# --- Rakuten Ichiba Item Search API ---
# https://webservice.rakuten.co.jp/
RAKUTEN_APP_ID=

# --- Yahoo! Shopping Japan API ---
# https://developer.yahoo.co.jp/webapi/shopping/
YAHOO_JP_APP_ID=

# --- Amazon Product Advertising API (PA-API 5) ---
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_HOST=webservices.amazon.com
AMAZON_PAAPI_REGION=us-east-1

# --- Keepa (Amazon price history) ---
KEEPA_API_KEY=

# --- Reddit Data API (OAuth script app) ---
# https://support.reddithelp.com/hc/en-us/articles/14945211791892
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=japan-dmv-arbitrage/1.0 (by u/your_username)

# --- YouTube Data API v3 ---
# https://console.cloud.google.com/ -> enable "YouTube Data API v3" -> create API key
YOUTUBE_API_KEY=

# --- Google Trends (pytrends) ---
# No API key needed. Install the client:  pip install ".[trends]"
# Enable/tune geos + timeframe in config/sources.yaml (source: google_trends).
# Run with:  python -m app.cli collect --sources google_trends --run-id <id>

# --- Global knobs ---
# FX fallback if no live rate provided (USD per 1 JPY). ~0.0067 == 150 JPY/USD.
JPY_TO_USD_RATE=0.0067
# Seconds between requests per collector (be polite; monthly cadence anyway).
COLLECTOR_MIN_INTERVAL_SECONDS=2
